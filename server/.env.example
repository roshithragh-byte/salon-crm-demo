# Database (Neon PostgreSQL or similar)
DATABASE_URL="postgresql://user:password@host:port/dbname?sslmode=require"

# JWT Auth Secret (Must match client NEXTAUTH_SECRET)
NEXTAUTH_SECRET="your-strong-random-secret"

# Environment and Hosting
NODE_ENV="production"
PORT=3001
API_PORT=3001
ALLOWED_ORIGIN="https://your-production-frontend-url.vercel.app"
