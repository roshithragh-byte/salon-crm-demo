# NextAuth settings
NEXTAUTH_SECRET="your-strong-random-secret"
NEXTAUTH_URL="https://your-production-frontend-url.vercel.app"

# API Backend Configuration
# Points to the deployed Node/NestJS backend
NEXT_PUBLIC_API_URL="https://your-production-backend-url.onrender.com/api/v1"
API_BASE_URL="https://your-production-backend-url.onrender.com"

# Optional Upstash Redis for caching
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
